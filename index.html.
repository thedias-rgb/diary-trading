
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#090b10">
<title>XAUUSD Journal</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;background:#090b10;color:#eef3f8;font:15px Arial,sans-serif;max-width:650px;margin:auto}
h1{font-size:23px;color:#36d399}
.card{background:#151c27;border:1px solid #293447;border-radius:15px;padding:16px;margin:12px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.metric{font-size:24px;font-weight:bold;margin-top:8px}
.muted{color:#8d9aab;font-size:12px}
input,select,textarea{width:100%;padding:12px;margin:6px 0 12px;background:#0c1118;color:white;border:1px solid #293447;border-radius:9px}
button{padding:12px;background:#36d399;color:#07120f;border:0;border-radius:9px;font-weight:bold;cursor:pointer}
button.secondary{background:#293447;color:white}
label{font-size:12px;color:#8d9aab}
.green{color:#36d399}.red{color:#ff647c}
.trade{display:flex;justify-content:space-between;border-bottom:1px solid #293447;padding:12px 0}
nav{display:flex;gap:7px;margin:15px 0}
nav button{flex:1;background:#202938;color:white}
section{display:none}section.active{display:block}
</style>
</head>
<body>
<h1>◈ XAUUSD JOURNAL</h1>
<div class="muted">PERSONAL TRADING TRACKER · FUNDINGPIPS</div>

<nav>
<button onclick="tab('dash')">Dashboard</button>
<button onclick="tab('add')">+ Trade</button>
<button onclick="tab('history')">History</button>
</nav>

<section id="dash" class="active">
<div class="grid">
<div class="card"><div class="muted">NET P&L</div><div class="metric" id="pnl">$0.00</div></div>
<div class="card"><div class="muted">WIN RATE</div><div class="metric" id="wr">0%</div></div>
<div class="card"><div class="muted">TRADES</div><div class="metric" id="count">0</div></div>
<div class="card"><div class="muted">PROFIT FACTOR</div><div class="metric" id="pf">—</div></div>
</div>
<div class="card">
<b>Recent trades</b>
<div id="recent" class="muted">No trades yet.</div>
</div>
</section>

<section id="add">
<div class="card">
<h3>New trade</h3>
<form id="form">
<label>Date</label><input id="date" type="date" required>
<label>Direction</label>
<select id="direction"><option>BUY</option><option>SELL</option></select>
<label>Result in USD</label><input id="result" type="number" step=".01" required placeholder="50.00">
<label>Entry price</label><input id="entry" type="number" step=".01">
<label>Exit price</label><input id="exit" type="number" step=".01">
<label>Lot size</label><input id="lot" type="number" step=".01">
<label>Strategy</label>
<select id="setup">
<option>Liquidity Sweep</option><option>BOS</option><option>CHoCH</option><option>FVG</option><option>Order Block</option><option>VAH / VAL</option><option>Other</option>
</select>
<label>Entry reason</label><textarea id="notes"></textarea>
<label>Mistakes / Psychology</label><textarea id="psych"></textarea>
<button type="submit" style="width:100%">SAVE TRADE</button>
</form>
</div>
</section>

<section id="history">
<div class="card">
<b>Trade history</b>
<div id="list"></div>
<button class="secondary" onclick="backup()">Export backup</button>
</div>
</section>

<script>
const KEY="xauusd_journal";
let trades=JSON.parse(localStorage.getItem(KEY)||"[]");

function tab(id){
document.querySelectorAll("section").forEach(s=>s.classList.remove("active"));
document.getElementById(id).classList.add("active");
render();
}

function money(n){
return (n<0?"-$":"$")+Math.abs(n).toFixed(2);
}

function render(){
let pnl=trades.reduce((s,t)=>s+Number(t.result),0);
let wins=trades.filter(t=>Number(t.result)>0);
let losses=trades.filter(t=>Number(t.result)<0);
let gw=wins.reduce((s,t)=>s+Number(t.result),0);
let gl=Math.abs(losses.reduce((s,t)=>s+Number(t.result),0));

document.getElementById("pnl").textContent=money(pnl);
document.getElementById("pnl").className="metric "+(pnl>=0?"green":"red");
document.getElementById("wr").textContent=(trades.length?Math.round(wins.length/trades.length*100):0)+"%";
document.getElementById("count").textContent=trades.length;
document.getElementById("pf").textContent=gl?(gw/gl).toFixed(2):(gw?"∞":"—");

let html=trades.slice().reverse().map((t,i)=>`
<div class="trade">
<div>
<b>${t.direction} · ${t.setup}</b>
<div class="muted">${t.date} · ${t.lot||"—"} lot</div>
</div>
<b class="${Number(t.result)>=0?"green":"red"}">${money(Number(t.result))}</b>
</div>`).join("");

document.getElementById("recent").innerHTML=html||"No trades yet.";
document.getElementById("list").innerHTML=html||"No trades yet.";
}

document.getElementById("date").value=new Date().toISOString().slice(0,10);

document.getElementById("form").addEventListener("submit",e=>{
e.preventDefault();
trades.push({
date:date.value,
direction:direction.value,
result:Number(result.value),
entry:entry.value,
exit:exit.value,
lot:lot.value,
setup:setup.value,
notes:notes.value,
psych:psych.value
});
localStorage.setItem(KEY,JSON.stringify(trades));
e.target.reset();
date.value=new Date().toISOString().slice(0,10);
tab("dash");
});

function backup(){
let blob=new Blob([JSON.stringify(trades,null,2)],{type:"application/json"});
let a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="xauusd-backup.json";
a.click();
}

render();
</script>
</body>
</html>
